        {
          "id": "7a2c189c-4676-438a-838e-a91a0a06be69",
          "name": "Get NodeInfo server metadata",
          "request": {
            "name": "Get NodeInfo server metadata",
            "description": {
              "content": "Returns server capability metadata including software name, version, supported protocols, usage statistics, and open registration status.",
