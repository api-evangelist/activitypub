        {
          "id": "6ca2909c-d0c1-41b1-bec3-23b4ccd50217",
          "name": "Publish activity (client-to-server)",
          "request": {
            "name": "Publish activity (client-to-server)",
            "description": {
              "content": "Used by authenticated clients to publish activities on behalf of an actor. The server MUST assign an id to the activity and add it to the actor's outbox. The server then federates the activity to the appropriate recipients based on addressing fields (to, cc, bcc, audience). Returns 201 Created with a Location header pointing to the new activity's IRI.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":username",
                "outbox"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "username",
                  "description": "(Required) The local username of the actor"
                },
                {
                  "description": "The domain of the ActivityPub server",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/activity+json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@context\": \"<string>\",\n  \"type\": \"<string>\",\n  \"actor\": \"<uri>\",\n  \"id\": \"<uri>\",\n  \"object\": \"<uri>\",\n  \"target\": \"<uri>\",\n  \"to\": \"<uri>\",\n  \"cc\": \"<uri>\",\n  \"bto\": \"<uri>\",\n  \"bcc\": \"<uri>\",\n  \"published\": \"<dateTime>\",\n  \"summary\": \"<string>\",\n  \"result\": \"<uri>\",\n  \"origin\": \"<uri>\",\n  \"instrument\": \"<uri>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
